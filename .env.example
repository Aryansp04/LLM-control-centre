# ==============================================================================
# LLM Control Center — Environment Configuration (.env.example)
# NEVER commit real secrets or provider API keys to version control.
# ==============================================================================

# Application
APP_NAME="LLM Control Center"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security Secrets (Generate fresh 32+ byte random secrets in production)
JWT_SECRET_KEY=change-me-in-production-use-64-char-cryptographic-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720
ENCRYPTION_SECRET_KEY=change-me-in-production-use-32-byte-fernet-derivation-secret

# CORS & HTTP Limits
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BODY_BYTES=10485760
MAX_ATTACHMENT_BYTES=5242880
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=15

# Primary Database (PostgreSQL in Docker / Production)
DATABASE_URL=postgresql+asyncpg://llmcc:llmcc_password@localhost:5432/llm_control_center
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (Caching, Ephemeral Sessions, Rate Limiting, Pub/Sub, Job Locks)
REDIS_URL=redis://localhost:6379/0

# Optional System-Level Fallback Provider API Keys (Server-Side Only!)
# Users can also securely connect and encrypt their own per-account keys in Settings.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Monitoring Engine
BACKGROUND_MONITORING_ENABLED=true
BACKGROUND_MONITORING_INTERVAL_SECONDS=180
PROVIDER_HTTP_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2

# Frontend Build Variable (No secrets ever placed in VITE_ variables)
VITE_API_BASE_URL=http://localhost:8000
